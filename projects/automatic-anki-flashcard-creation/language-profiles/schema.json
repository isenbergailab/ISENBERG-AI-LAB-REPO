{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/automatic-anki-flashcard-creation/language-profile.schema.json",
  "title": "Automatic Anki Language Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "target_language", "explanation_language", "roles", "rules"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "target_language": {"type": "string", "minLength": 2},
    "explanation_language": {"type": "string", "minLength": 2},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Prompt", "Answer", "Notes", "Example"],
      "properties": {
        "Prompt": {"type": "string", "minLength": 1},
        "Answer": {"type": "string", "minLength": 1},
        "Notes": {"type": "string", "minLength": 1},
        "Example": {"type": "string", "minLength": 1}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "example_separator": {"type": "string", "default": "<br>"},
    "approved_reference_domains": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
