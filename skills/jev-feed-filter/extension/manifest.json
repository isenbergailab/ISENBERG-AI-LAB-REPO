{
  "manifest_version": 3,
  "name": "Jev Feed Filter for X",
  "version": "0.1.0",
  "description": "Collapses ragebait, AI slop and engagement bait on X using TypeSafe Jev.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Jev Feed Filter",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "options_page": "src/options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
